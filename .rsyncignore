# This repo uses rsync to synchronize the docs from upstream Bazel
# to the root of this repo. This file excludes certain files that only
# exist in this repo to ensure they're not deleted during the rsync process.
/.*
/*.json
/*.sh
/MODULE.bazel*
/LICENSE
/CLAUDE.md
/AGENTS.md
/README.md
/index.mdx
/favicon.png
/upstream
/patches
/agent-skills
/scripts
/navigation
# Generated by gen_mdx_reference_docs and extracted after the rsync.
/reference/be
/reference/command-line-reference.mdx
/rules/lib
